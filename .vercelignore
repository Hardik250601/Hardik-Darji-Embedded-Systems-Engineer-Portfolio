# Internal planning and handover notes. These must never be served publicly:
# several of them contain local filesystem paths with a username and employer
# name.
README.md
DEPLOY.md
GO-LIVE.md
FINAL-GO-LIVE.md
PROJECT_AUDIT.md
WHAT-CHANGED.md
PROJECT_OVERVIEW.md

# Unused on the site (the site uses an initials avatar, not this photo).
Hardik Profile PIC.png

# Vercel does not need repository or CI metadata to serve the site.
.git
.github
.gitignore
.nojekyll

# Tailwind and Node build inputs. tailwind.css is generated and COMMITTED, and
# the API uses Node's built-in Fetch API, so hosting needs no package install
# or build step - Vercel serves the static output and the api/ function.
package.json
package-lock.json
node_modules
src
tailwind.config.js

# OG/social-image generator and its font cache. The generated images and the
# static per-entry pages ARE published (images/og/ and project-*.html /
# blog-*.html at the repo root) - only the tooling that creates them is not.
scripts
.og-cache

# Serverless functions are published (api/). The MongoDB helper is used only
# by local tooling and is not needed by the deployed newsletter function.
lib
